# ClassRelay environment. Copy to .env.local. Secrets stay server-side; never commit real values.

# --- Demo ---
PUBLIC_DEMO=true                      # every judge route is public; each visitor gets an isolated sandbox

# --- Data (optional). Without these the app runs on the seeded in-browser sandbox ("Data mode: Sandbox").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # public anon key (RLS enforced)
SUPABASE_SERVICE_ROLE_KEY=            # server only: migrations / seed scripts

# --- AI (optional). Without a key agents return recorded sample outputs ("Sample mode").
ANTHROPIC_API_KEY=                    # server only
NEXT_PUBLIC_AI_LIVE=false             # set true only when ANTHROPIC_API_KEY is configured (exposes a boolean, never the key)
# Model routing table (no model name is hard-coded in feature code)
AI_MODEL_FAST=claude-haiku-5-5        # extraction, intake
AI_MODEL_REASONING=claude-opus-5-5    # matching explanations, briefs, handoffs
AI_MODEL_VISION=claude-sonnet-5-5     # credential documents, handwritten plans
AI_MODEL_EMBED=local-bm25             # retrieval (pgvector embeddings when Supabase is configured)
AI_MODEL_FALLBACK=claude-sonnet-5-5
AI_SPEND_CAP_USD=25                   # per-tenant daily spend cap
AI_RATE_LIMIT_PER_MIN=20              # per visitor
